{
	admin off
	auto_https disable_redirects
}

{$ARCHVIZ_HTTPS_HOST} {
	tls {
		issuer acme {
			disable_http_challenge
		}
	}
	@api path /api/*
	handle @api {
		reverse_proxy backend:8000 {
			header_up X-Real-IP {remote_host}
		}
	}
	@exports path /exports /exports/*
	handle @exports {
		respond 404
	}
	handle {
		reverse_proxy frontend:80
	}
}
